---
import Base from "~/layouts/Base.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import readingTime from "reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<"posts"> }
const { post } = Astro.props;
const { Content, headings } = await post.render();
const rt = readingTime(post.body);
const dateFmt = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" });

const canonical = post.data.canonical ?? `https://vedangkarwa.com/posts/${post.slug}`;

// TOC: pull only h2's (the "## /NN Title" pattern)
const toc = headings.filter(h => h.depth === 2);
---

<Base
  title={`${post.data.title} — Vedang Karwa`}
  description={post.data.description}
  canonical={canonical}
  nav="none"
  screenLabel="04 Single post"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    author: { "@type": "Person", name: "Vedang Karwa", url: "https://vedangkarwa.com" },
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    wordCount: rt.words,
    mainEntityOfPage: canonical,
    keywords: post.data.tag,
  }}
>
  <main class="wrap">

    <section class="post-hero">
      <div class="crumbs">
        <a href="/">vedang</a>
        <span class="sep">/</span>
        <a href="/archive">archive</a>
        <span class="sep">/</span>
        <span>{post.data.pubDate.getFullYear()} · {String(post.data.pubDate.getMonth() + 1).padStart(2, "0")}</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="post-meta">
        <span><b>Vedang Karwa</b></span>
        <span>Published <b>{dateFmt.format(post.data.pubDate)}</b></span>
        <span>Reading time <b>{rt.text}</b></span>
        <span>Filed under <b>{post.data.tag}</b></span>
        <span>{rt.words.toLocaleString()} words</span>
      </div>
    </section>

    <section class="post-body">

      <aside class="toc" aria-label="Table of contents">
        <div class="label">// Contents</div>
        <ol>
          {toc.map(h => (
            <li><a href={`#${h.slug}`}>{h.text.replace(/^\/\d+\s+/, "")}</a></li>
          ))}
        </ol>
        <div class="progress" aria-hidden="true"><div class="bar" id="bar"></div></div>
        <div style="margin-top:18px;font-family:var(--f-mono);font-size:11px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;">
          <a href="#" id="copyLink" style="border-bottom:1px solid var(--rule-soft);padding-bottom:1px;">Copy link →</a>
        </div>
      </aside>

      <article class="prose">
        <Content />

        <div class="cite-block" aria-label="Cite this post">
          <div class="ch">
            <span>// Cite this post</span>
            <button class="copy" data-copy="cite">Copy</button>
          </div>
          <div class="cb" id="cite">
            Karwa, Vedang. <em>{post.data.title}.</em>
            vedangkarwa.com, {dateFmt.format(post.data.pubDate)}. {canonical}
          </div>
        </div>
      </article>

      <div></div>
    </section>

    <section class="post-end">
      <div>
        <h3>// Share</h3>
        <div class="share">
          <a class="btn" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(post.data.title)}`}>X / Twitter <span class="arr">→</span></a>
          <a class="btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}>LinkedIn <span class="arr">→</span></a>
          <a class="btn" href={`https://news.ycombinator.com/submitlink?u=${encodeURIComponent(canonical)}&t=${encodeURIComponent(post.data.title)}`}>Hacker News <span class="arr">→</span></a>
        </div>
      </div>
      <div>
        <h3>// Next up</h3>
        <a class="btn primary" href="/archive" style="width:100%;justify-content:space-between">
          Back to archive <span class="arr">→</span>
        </a>
      </div>
    </section>

  </main>
</Base>

<script>
  // Reading progress + TOC active state + copy buttons
  const bar = document.getElementById("bar") as HTMLDivElement | null;
  const rprog = document.getElementById("rprog");
  const sections = [...document.querySelectorAll<HTMLElement>(".prose h2[id]")];
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];

  function onScroll() {
    const h = document.documentElement;
    const total = h.scrollHeight - h.clientHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, h.scrollTop / total)) : 0;
    if (bar) bar.style.width = (p * 100).toFixed(1) + "%";
    if (rprog) rprog.textContent = Math.round(p * 100) + "%";

    let active = sections[0]?.id;
    for (const s of sections) {
      if (s.getBoundingClientRect().top < 140) active = s.id;
    }
    tocLinks.forEach(a => a.classList.toggle("active", a.getAttribute("href") === "#" + active));
  }
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  document.querySelectorAll<HTMLButtonElement>(".copy").forEach(btn => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.copy!;
      const txt = (document.getElementById(id) as HTMLElement | null)?.innerText ?? "";
      navigator.clipboard?.writeText(txt.trim()).then(() => {
        const o = btn.textContent; btn.textContent = "Copied"; setTimeout(() => { btn.textContent = o; }, 1200);
      });
    });
  });
  document.getElementById("copyLink")?.addEventListener("click", e => {
    e.preventDefault();
    navigator.clipboard?.writeText(location.href);
    const a = e.currentTarget as HTMLAnchorElement;
    const o = a.textContent;
    a.textContent = "Copied →";
    setTimeout(() => { a.textContent = o; }, 1200);
  });
</script>
